cabal-version:      3.0
name:               repos
version:            0.1.0.0

common deps
    ghc-options:      -O2 -Wall
    build-depends:    base, aeson, lucid2, text
    default-language: GHC2024

library
    import:           deps
    hs-source-dirs:   src
    exposed-modules:  CommitData View

executable commits
    import:           deps
    hs-source-dirs:   app
    main-is:          main.hs
    build-depends:    repos

