cabal-version:      3.0
name:               exos
version:            0.1.0.0

common deps
    ghc-options:      -O2 -Wall -Wno-unused-imports
    build-depends:    base, aeson, bytestring, text, yaml
    default-language: GHC2024

executable app1
    import:           deps
    hs-source-dirs:   app
    main-is:          app1.hs

executable app2
    import:           deps
    hs-source-dirs:   app
    main-is:          app2.hs

