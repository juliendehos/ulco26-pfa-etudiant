cabal-version:      3.0
name:               compute
version:            0.1.0.0

common deps
    ghc-options:      -O2 -Wall
    build-depends:    base, transformers
    default-language: GHC2024

executable compute1
    import:           deps
    hs-source-dirs:   app
    main-is:          compute1.hs

executable compute2
    import:           deps
    hs-source-dirs:   app
    main-is:          compute2.hs

