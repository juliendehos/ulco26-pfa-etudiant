cabal-version:      3.0
name:               fibo
version:            0.1.0.0

common deps
    ghc-options:      -O2 -Wall
    build-depends:    base, containers, optparse-applicative, transformers
    default-language: GHC2024

executable fibo
    import:           deps
    hs-source-dirs:   app
    main-is:          main.hs

