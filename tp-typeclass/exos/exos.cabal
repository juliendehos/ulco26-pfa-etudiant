cabal-version:      3.0
name:               exos
version:            0.1.0.0

common deps
    ghc-options:      -Wall -O2
    build-depends:    base
    default-language: GHC2024

library
    import:           deps
    hs-source-dirs:   src
    exposed-modules:  Compute List

executable exos
    import:           deps
    hs-source-dirs:   app
    main-is:          main.hs

