cabal-version:      3.0
name:               maze
version:            0.1.0.0

common deps
    ghc-options:      -O2 -Wall -ddump-splices
    default-language: GHC2024
    build-depends:    base, gloss, lens, text, vector

library
    import:           deps
    hs-source-dirs:   src
    exposed-modules:  Maze Parse

executable maze
    import:           deps
    hs-source-dirs:   app
    main-is:          main.hs
    build-depends:    maze

