cabal-version:      3.0
name:               hello-glosslens
version:            0.1.0.0

common deps
    ghc-options:      -O2 -Wall -ddump-splices
    default-language: GHC2024
    build-depends:    base, gloss, lens, transformers

library
    import:           deps
    hs-source-dirs:   src
    exposed-modules:  Game1 Game2 Game3

executable hello-glosslens1
    import:           deps
    hs-source-dirs:   app
    main-is:          hello-glosslens1.hs
    build-depends:    hello-glosslens

executable hello-glosslens2
    import:           deps
    hs-source-dirs:   app
    main-is:          hello-glosslens2.hs
    build-depends:    hello-glosslens

executable hello-glosslens3
    import:           deps
    hs-source-dirs:   app
    main-is:          hello-glosslens3.hs
    build-depends:    hello-glosslens

