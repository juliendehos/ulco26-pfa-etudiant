cabal-version:      3.0
name:               snake
version:            0.1.0.0

common deps
    ghc-options:      -O2 -Wall -ddump-splices
    default-language: GHC2024
    build-depends:    base, gloss, lens, linear, random, transformers

library
    import:           deps
    hs-source-dirs:   src
    exposed-modules:  Snake

executable snake
    import:           deps
    hs-source-dirs:   app
    main-is:          main.hs
    build-depends:    snake

